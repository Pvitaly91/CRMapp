<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="CredentialIndicatorStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#667085" /><Setter Property="Background" Value="#F2F4F7" />
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,4" /><Setter Property="Margin" Value="3,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Saved"><Setter Property="Foreground" Value="#166534" /><Setter Property="Background" Value="#E8F5E9" /></Trigger>
            <Trigger Property="Tag" Value="Draft"><Setter Property="Foreground" Value="#B45309" /><Setter Property="Background" Value="#FFF5E0" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="3" />
    </Style>
</ResourceDictionary>
