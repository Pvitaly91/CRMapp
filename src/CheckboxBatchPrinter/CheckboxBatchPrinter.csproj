<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CheckboxBatchPrinter</AssemblyName>
    <RootNamespace>CheckboxBatchPrinter</RootNamespace>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
    <AppChannel Condition="'$(AppChannel)' == ''">Development</AppChannel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CheckboxBatchPrinter.Core\CheckboxBatchPrinter.Core.csproj" />
  </ItemGroup>
  <Target Name="EmbedAppChannel" BeforeTargets="GetAssemblyAttributes">
    <Error Condition="'$(AppChannel)' != 'Development' and '$(AppChannel)' != 'Production'" Text="AppChannel must be Development or Production." />
    <ItemGroup>
      <AssemblyMetadata Include="AppChannel" Value="$(AppChannel)" />
      <AssemblyMetadata Include="BuildCommit" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>
</Project>
