<Window x:Class="CheckboxBatchPrinter.Views.PrintConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підтвердження друку" Height="650" Width="620" MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Скасувати" IsCancel="True" />
            <Button Content="Передати в чергу Windows" IsDefault="True" Click="Confirm_Click"
                    Background="#1769AA" Foreground="White" FontWeight="SemiBold" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="HiddenText" Grid.Row="1" Margin="0,8,0,0" Foreground="#B54708" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Text="Незмінний порядок поточного пакета:" Margin="0,14,0,6" FontWeight="SemiBold" />
            <ListBox x:Name="ReceiptList" Grid.Row="3" BorderBrush="#D0D5DD" />
            <Border x:Name="RepeatWarning" Grid.Row="4" Background="#FFF1F0" BorderBrush="#FDA29B" BorderThickness="1"
                    Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="УВАГА: у пакеті є чеки з непідтвердженим попереднім результатом. Вони могли вже вийти на папір. Повторюйте лише після фізичної перевірки."
                           Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <TextBlock Grid.Row="5" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#475467"
                       Text="Окремий Windows job не гарантує фізичний друк або автообрізання. Повторна фіскалізація не виконується." />
        </Grid>
    </DockPanel>
</Window>
