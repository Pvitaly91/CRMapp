<Window x:Class="CheckboxBatchPrinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CheckboxBatchPrinter.Controls"
        Title="Checkbox Batch Printer" Height="760" Width="1320" MinHeight="600" MinWidth="1000"
        Icon="/CheckboxBatchPrinter;component/Resources/app-icon.ico"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="PrintCandidatesIcon">
            <Viewbox Width="14" Height="14" IsHitTestVisible="False">
                <Canvas Width="20" Height="20">
                    <Path Data="M2,3 L18,3 L12,10 L12,15 L8,17 L8,10 Z" Fill="#E8F3FF"
                          Stroke="#1769AA" StrokeThickness="1.6" StrokeLineJoin="Round" />
                    <Path Data="M11,14 L14,17 L19,11" Stroke="White" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path Data="M11,14 L14,17 L19,11" Stroke="#17803D" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <Style x:Key="PrintCandidatesButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="Вибрати" />
            <Setter Property="ContentTemplate" Value="{StaticResource PrintCandidatesIcon}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="DashboardTextCopyMenu" x:Shared="False">
            <MenuItem Header="Копіювати (Ctrl+C)" Command="{x:Static ApplicationCommands.Copy}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Виділити весь текст" Command="{x:Static ApplicationCommands.SelectAll}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <Style x:Key="DashboardTextStyle" TargetType="controls:DashboardTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
            <Setter Property="ContextMenu" Value="{StaticResource DashboardTextCopyMenu}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style x:Key="DashboardAmountTextStyle" TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DashboardLinkTextStyle" TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}">
            <Setter Property="Foreground" Value="#0066CC" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="DashboardCopyMenu" x:Shared="False">
            <MenuItem Header="Копіювати (Ctrl+C)" Command="{x:Static ApplicationCommands.Copy}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <Style x:Key="PreserveInactiveRowColor" TargetType="DataGridCell">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiptRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LinkedMarketplace}" Value="Prom">
                    <Setter Property="Background" Value="#EDF5FF" />
                    <Setter Property="Foreground" Value="#143E70" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LinkedMarketplace}" Value="Rozetka">
                    <Setter Property="Background" Value="#EFFAF2" />
                    <Setter Property="Foreground" Value="#175A35" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding LinkedMarketplace}" Value="Prom" />
                        <Condition Binding="{Binding PrintStatus}" Value="Done" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BFDAFA" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding LinkedMarketplace}" Value="Rozetka" />
                        <Condition Binding="{Binding PrintStatus}" Value="Done" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BCE8C9" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding PrintStatus}" Value="Done"><Setter Property="ToolTip" Value="{Binding PrintError}" /></DataTrigger>
                <DataTrigger Binding="{Binding PrintStatus}" Value="Error"><Setter Property="ToolTip" Value="{Binding PrintError}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WaybillRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#EDF5FF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CarrierName}" Value="Rozetka Delivery">
                    <Setter Property="Background" Value="#EFFAF2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter Property="Foreground" Value="#667085" />
                    <Setter Property="ToolTip" Value="Накладну видалено в сервісі доставки" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPrintedLabel}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="{Binding PrintStatusText}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CarrierName}" Value="Нова пошта" />
                        <Condition Binding="{Binding HasPrintedLabel}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BFDAFA" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CarrierName}" Value="Rozetka Delivery" />
                        <Condition Binding="{Binding HasPrintedLabel}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BCE8C9" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="ToolTip" Value="{Binding Marketplace}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Marketplace}" Value="Prom">
                    <Setter Property="Background" Value="#EDF5FF" />
                    <Setter Property="Foreground" Value="#143E70" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Marketplace}" Value="Rozetka">
                    <Setter Property="Background" Value="#EFFAF2" />
                    <Setter Property="Foreground" Value="#175A35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPrintedLabel}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="{Binding LabelPrintStatus}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Marketplace}" Value="Prom" />
                        <Condition Binding="{Binding HasPrintedLabel}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BFDAFA" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Marketplace}" Value="Rozetka" />
                        <Condition Binding="{Binding HasPrintedLabel}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BCE8C9" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Marketplace}" Value="Prom" />
                        <Condition Binding="{Binding HasDispatchedShipments}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#8CB9EB" />
                    <Setter Property="ToolTip" Value="{Binding DispatchToolTip}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Marketplace}" Value="Rozetka" />
                        <Condition Binding="{Binding HasDispatchedShipments}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#85CDA0" />
                    <Setter Property="ToolTip" Value="{Binding DispatchToolTip}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Model.IsCanceled}" Value="True">
                    <Setter Property="Background" Value="#FDE8E7" />
                    <Setter Property="Foreground" Value="#8A2020" />
                    <Setter Property="ToolTip" Value="{Binding Status}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiptGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
            <Setter Property="ContextMenu" Value="{StaticResource DashboardCopyMenu}" />
            <EventSetter Event="Loaded" Handler="Dashboard_Loaded" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Dashboard_RightClick" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="#D9DEE7" />
            <Setter Property="RowStyle" Value="{StaticResource ReceiptRowStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource PreserveInactiveRowColor}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel>
                    <TextBlock Text="Дата від" VerticalAlignment="Center" Margin="3" />
                    <DatePicker Width="145" SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Період чеків, замовлень і накладних (Київ)." />
                    <Button Content="×" Command="{Binding ClearDateCommand}" CommandParameter="from"
                            ToolTip="Скинути дату від" MinWidth="28" Padding="5,2" />
                    <TextBlock Text="Дата до" VerticalAlignment="Center" Margin="8,3,3,3" />
                    <DatePicker Width="145" SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Період за датою (Київ). Для завантаження накладних виберіть обидві дати." />
                    <Button Content="×" Command="{Binding ClearDateCommand}" CommandParameter="to"
                            ToolTip="Скинути дату до" MinWidth="28" Padding="5,2" />
                    <Button Content="Сьогодні" Command="{Binding TodayCommand}" />
                    <Button x:Name="RefreshAllButton" Content="{Binding RefreshAllButtonText}" Command="{Binding RefreshAllCommand}"
                            ToolTipService.ShowDuration="60000">
                        <Button.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="620">
                                <StackPanel>
                                    <TextBlock Text="F5 — оновити чеки, замовлення, автоприв’язки та накладні за вибраний період" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3" />
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="3" />
                                    <TextBlock Text="{Binding Marketplace.Status}" TextWrapping="Wrap" Margin="3" />
                                    <TextBlock Text="{Binding Waybills.Status}" TextWrapping="Wrap" Margin="3" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Скасувати оновлення" Command="{Binding CancelRefreshAllCommand}"
                            Visibility="{Binding IsRefreshingAll, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <Button Grid.Column="1" Content="Налаштування" Command="{Binding SettingsCommand}" VerticalAlignment="Top" />
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="3" />
                    <TextBox x:Name="ReceiptSearchInput" Width="330" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Пошук у поточній вкладці за номером та даними документа. Для чеків також: ID або точна сума, наприклад 320, 320.00 чи 320,00." />
                    <ComboBox Width="180" ItemsSource="{Binding ReceiptTypes}" SelectedItem="{Binding SelectedType}"
                              Visibility="{Binding IsReceiptTab, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="TodayReceiptsButton" Content="Чеки за сьогодні" Command="{Binding TodayCommand}"
                            Visibility="{Binding IsReceiptTab, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Показати чеки за сьогодні (Київ): скинути пошук і тип та одразу оновити список" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="ReceiptPrintFooter" DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,1,0,0" Padding="10"
                Visibility="{Binding IsReceiptTab, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    <Button Content="Перегляд" Command="{Binding PreviewCommand}" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="110" Height="14" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="10,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Повторити невдалі" Command="{Binding RetryFailedCommand}" />
                    <Button Content="Друк вибраних видимих" Command="{Binding PrintSelectedCommand}" FontWeight="Bold"
                            Background="#1769AA" Foreground="White" ToolTip="Ctrl+P — друк вибраних видимих в активній вкладці" Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WaybillPrintFooter" DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,1,0,0" Padding="10"
                Visibility="{Binding IsWaybillsTab, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding Waybills.SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    <Button Content="Перегляд" Command="{Binding Waybills.PreviewCommand}" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="110" Height="14" IsIndeterminate="True" Visibility="{Binding Waybills.IsPrintingBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Waybills.PrintStatus}" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.Column="1">
                    <Button Content="Скасувати підготовку" Command="{Binding Waybills.CancelPrintCommand}" />
                    <Button Content="Повторити невдалі" Command="{Binding Waybills.RetryFailedCommand}" />
                    <Button Content="Друк вибраних видимих" Command="{Binding Waybills.PrintSelectedCommand}" FontWeight="Bold"
                            Background="#1769AA" Foreground="White" ToolTip="Ctrl+P — друк позначених видимих накладних" Padding="18,7" />
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RefreshAllStatus}" Margin="14,3" Foreground="#48566A" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="14,4,14,8" Foreground="#48566A"
                   Visibility="{Binding IsReceiptTab, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding BackgroundStatus}" Margin="14,3" Foreground="#667085"
                   Visibility="{Binding IsReceiptTab, Converter={StaticResource BoolToVisibility}}" />

        <TabControl x:Name="ReceiptTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="10,8,10,2">
            <TabItem Header="Усі чеки">
                <DataGrid x:Name="AllReceiptsGrid" ItemsSource="{Binding AllReceiptsTab.View}" Style="{StaticResource ReceiptGridStyle}"
                          CurrentCellChanged="Dashboard_CurrentCellChanged"
                          SelectedItem="{Binding AllReceiptsTab.SelectedReceipt, Mode=OneWayToSource}"
                          Sorting="DataGrid_Sorting" MouseDoubleClick="ReceiptsGrid_MouseDoubleClick" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="66" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <CheckBox x:Name="AllReceiptsHeaderToggle" IsThreeState="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="Вибрати або зняти всі чеки"
                                    ToolTip="Позначити видимі чеки; повторне натискання знімає всі галочки цієї таблиці" />
                                <Button x:Name="AllReceiptsPrintCandidatesButton" Style="{StaticResource PrintCandidatesButtonStyle}"
                                        AutomationProperties.Name="Вибрати чеки — кандидати для друку"
                                        ToolTip="Позначити видимі ненадруковані чеки з пов’язаним нескасованим замовленням. Решту видимих галочок зняти; приховані зберегти." />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <controls:DashboardTextColumn Header="Дата й час" Binding="{Binding LocalDateTime, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}" Width="160" IsReadOnly="True" SortMemberPath="LocalDateTime" />
                        <controls:DashboardTextColumn Header="Сума" Binding="{Binding Total, StringFormat=N2}" Width="95" IsReadOnly="True"
                                                      ElementStyle="{StaticResource DashboardAmountTextStyle}" />
                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="Перегляд" Padding="6,2" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <controls:DashboardTextColumn Header="Фіскальний номер" Binding="{Binding FiscalCode}" Width="160" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Номер чека" Binding="{Binding Serial}" Width="105" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Тип чека" Binding="{Binding Type}" Width="135" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Оплата" Binding="{Binding Payment}" Width="155" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Статус" Binding="{Binding Status}" Width="105" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Каса" Binding="{Binding CashRegister}" Width="130" IsReadOnly="True" />
                        <controls:DashboardTextColumn Header="Друк" Binding="{Binding PrintStatusText}" Width="120" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Чеки та замовлення">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                        <Border Background="#EDF6FF" Padding="8" Margin="0,0,0,5"
                                Visibility="{Binding Marketplace.ShowSetupHint, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <TextBlock Text="Інтеграції не налаштовані.&#x0a;Усі чеки доступні на вкладці “Усі чеки”."
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,0,12,0" />
                            </WrapPanel>
                        </Border>
                        <ScrollViewer x:Name="OrdersWorkspaceToolbarScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="OrdersWorkspaceToolbar" Orientation="Horizontal">
                            <Button Content="Друк наклейок" Command="{Binding Marketplace.Labels.PrintCommand}" />
                            <Button x:Name="PrintOrdersWithReceiptsButton" Content="Друк наклейок і чеків" Command="{Binding PrintOrdersWithReceiptsCommand}"
                                    ToolTip="Друк наклейок і пов’язаних чеків вибраних видимих замовлень у порядку цієї таблиці." />
                            <TextBlock Text="ⓘ" Margin="6" VerticalAlignment="Center" ToolTip="{Binding Marketplace.Labels.Status}" />
                            <CheckBox x:Name="ExtraOrderColumns" Content="Покупець, статус у таблиці" VerticalAlignment="Center" Margin="12,0" />
                            <CheckBox x:Name="ShowCanceledOrdersCheck" Content="Показувати скасовані" VerticalAlignment="Center" Margin="8,0"
                                      IsChecked="{Binding Marketplace.ShowCanceledOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="За замовчуванням скасовані замовлення приховані. Увімкніть, щоб переглянути їх у таблиці." />
                        <CheckBox x:Name="AutomaticOrderLinks" Content="Автоприв’язка"
                                  IsChecked="{Binding Marketplace.AutoLinkEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="12,0,6,0" VerticalAlignment="Center"
                                  ToolTip="Одна календарна дата (Київ) і загальна сума; далі повні очищені назви та кількості всіх товарів. Спецсимволи прибираються лише для порівняння: літери, цифри й порядок слів зберігаються, цифрові частини не склеюються. Неповні дані не виключають кандидата. Оплата розрізняє лише однакові повні кошики. Ймовірний зв’язок не є фіскальним підтвердженням." />
                        <Button x:Name="MarketplaceInfoButton" Content="ⓘ" Width="30" Padding="3" FontSize="16"
                                AutomationProperties.Name="Стан оновлення та пояснення прив’язок"
                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="620">
                                    <StackPanel>
                                        <TextBlock Text="Стан оновлення та пояснення" FontWeight="SemiBold" Margin="3,3,3,7" />
                                        <TextBlock Text="{Binding Marketplace.Status}" TextWrapping="Wrap" Margin="3" />
                                        <TextBlock Text="{Binding Marketplace.FiscalSummary}" TextWrapping="Wrap" Margin="3" />
                                        <TextBlock Text="{Binding Marketplace.ReceiptScopeText}" TextWrapping="Wrap" Margin="3" />
                                        <TextBlock Text="{Binding Marketplace.OrderListSummary}" TextWrapping="Wrap" Margin="3" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <Expander DockPanel.Dock="Bottom" Header="Пов’язане замовлення / кандидати" IsExpanded="{Binding Marketplace.DetailsExpanded, Mode=TwoWay}" Margin="2,6,2,2">
                        <Grid MaxHeight="250">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel>
                                <Button Content="Зв’язати / змінити прив’язку" Command="{Binding Marketplace.LinkCommand}" />
                                <Button Content="Відв’язати" Command="{Binding Marketplace.UnlinkCommand}" />
                                <Button Content="Копіювати № замовлення" Command="{Binding Marketplace.CopyNumberCommand}" />
                                <Button Content="Копіювати ТТН" Command="{Binding Marketplace.CopyTrackingCommand}" />
                            </WrapPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Marketplace.DetailsText}" TextWrapping="Wrap" Margin="6" />
                                    <ItemsControl ItemsSource="{Binding Marketplace.OrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,2" TextWrapping="Wrap">
                                                    <Run Text="{Binding Sku}" /><Run Text=" — " /><Run Text="{Binding Name}" /><Run Text=" · " />
                                                    <Run Text="{Binding Quantity}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, StringFormat=N2}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Expander>

                    <Grid x:Name="OrdersSplitLayout">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="MarketplaceOrdersPane" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="OrderToolbarScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,3">
                            <StackPanel x:Name="OrderToolbar" Orientation="Horizontal">
                                <TextBox x:Name="OrderSearchInput" Width="115" VerticalAlignment="Center"
                                         AutomationProperties.Name="Пошук замовлень"
                                         Text="{Binding Marketplace.OrderSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Пошук лише серед завантажених замовлень — не приховує чеки праворуч." />
                                <ComboBox x:Name="OrderFilterInput" Width="95" VerticalAlignment="Center" ItemsSource="{Binding Marketplace.OrderFilters}"
                                          SelectedItem="{Binding Marketplace.OrderFilter}" ToolTip="Фільтр лише замовлень" />
                                <Button x:Name="LinkSelectedOrderButton" Content="Прив’язати вибрані" Padding="8,6" VerticalAlignment="Center"
                                        Command="{Binding Marketplace.LinkSelectedOrderCommand}"
                                        ToolTip="Виберіть замовлення ліворуч та чек праворуч. Прив’язку буде збережено лише після підтвердження." />
                            </StackPanel>
                            </ScrollViewer>
                            <DataGrid x:Name="MarketplaceOrdersGrid" Grid.Row="1" ItemsSource="{Binding Marketplace.Orders}"
                                      SelectedItem="{Binding Marketplace.SelectedOrder, Mode=OneWayToSource}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" HeadersVisibility="Column"
                                      ClipboardCopyMode="ExcludeHeader" ContextMenu="{StaticResource DashboardCopyMenu}"
                                      Loaded="Dashboard_Loaded" CurrentCellChanged="Dashboard_CurrentCellChanged" PreviewMouseRightButtonDown="Dashboard_RightClick"
                                      GridLinesVisibility="Horizontal" BorderBrush="#D9DEE7"
                                      RowStyle="{StaticResource OrderRowStyle}">
                                <DataGrid.CellStyle><StaticResource ResourceKey="PreserveInactiveRowColor" /></DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="76" CanUserSort="False" ClipboardContentBinding="{Binding DisplayIndex}">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <CheckBox x:Name="OrdersHeaderToggle" IsThreeState="True" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Вибрати або зняти всі замовлення для наклейок"
                                                    ToolTip="Позначити видимі замовлення з ТТН; повторне натискання знімає всі галочки наклейок" />
                                                <TextBlock Text="№" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Button x:Name="OrdersPrintCandidatesButton" Style="{StaticResource PrintCandidatesButtonStyle}"
                                                        AutomationProperties.Name="Вибрати замовлення — кандидати для друку наклейок"
                                                        ToolTip="Позначити видимі нескасовані замовлення з пов’язаним чеком, наклейки яких ще не передавалися на друк. Решту видимих галочок зняти; приховані зберегти." />
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsSelectedForLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Focusable="False" />
                                                <controls:DashboardTextBox Tag="OrderRowIndex" Style="{StaticResource DashboardTextStyle}"
                                                           Text="{Binding DisplayIndex, Mode=OneWay}" MinWidth="26" TextAlignment="Right" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" ToolTip="Номер запису в поточному списку" />
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <controls:DashboardTextColumn Header="№ замовлення" Binding="{Binding Number}" Width="115" />
                                    <controls:DashboardTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130" />
                                    <controls:DashboardTextColumn Header="Сума / валюта" Binding="{Binding TotalDisplay}" Width="115">
                                        <controls:DashboardTextColumn.ElementStyle>
                                            <Style TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardAmountTextStyle}"><Setter Property="ToolTip" Value="{Binding TotalDisplay}" /></Style>
                                        </controls:DashboardTextColumn.ElementStyle>
                                    </controls:DashboardTextColumn>
                                    <DataGridTemplateColumn Header="Відкрити чек" Width="150" ClipboardContentBinding="{Binding LinkedReceiptsDisplay}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2">
                                                    <Button Tag="OrderLinkInfo" DockPanel.Dock="Right" Content="ⓘ" Padding="3,1" MinWidth="24" Margin="4,0,0,0"
                                                            VerticalAlignment="Center" Click="OrderLinkInfo_Click" LostKeyboardFocus="OrderLinkInfo_LostKeyboardFocus"
                                                            AutomationProperties.Name="Інформація про зв’язок із чеками"
                                                            AutomationProperties.HelpText="{Binding LinkStatus}"
                                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                                        <Button.ToolTip>
                                                            <ToolTip MaxWidth="520" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Marketplace}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding LinkStatus}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding LinkedReceiptsDisplay}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding LinkExplanation}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                <StackPanel>
                                                <Button Content="Прив’язати" Tag="ChooseReceiptForOrder"
                                                        Command="{Binding DataContext.Marketplace.ChooseReceiptForOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasNoReceiptLink, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Вибрати вільний завантажений чек і прив’язати до цього замовлення" />
                                                <ItemsControl ItemsSource="{Binding LinkedReceipts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Serial}" ContentStringFormat="Чек №{0}"
                                                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <controls:DashboardTextColumn Header="Покупець" Binding="{Binding BuyerDisplay}" Width="180"
                                        Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:DashboardTextColumn Header="Статус замовлення" Binding="{Binding Status}" Width="150"
                                        Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                                    <DataGridTemplateColumn Header="ТТН" Width="160" SortMemberPath="TrackingDisplay" ClipboardContentBinding="{Binding TrackingDisplay}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding ShipmentLinks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="4,3">
                                                                <controls:DashboardTextBox Tag="OrderTrackingNumber" Style="{StaticResource DashboardLinkTextStyle}" Margin="0" VerticalAlignment="Center"
                                                                    Text="{Binding TrackingNumber, Mode=OneWay}"
                                                                    ToolTip="Виділіть текст мишкою; клік відкриває наклейку цієї ТТН"
                                                                    Command="{Binding DataContext.Marketplace.Labels.PreviewShipmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                                <controls:DashboardTextBox Tag="OrderTrackingStatus" Style="{StaticResource DashboardTextStyle}"
                                                                    Margin="0,2,0,0" FontSize="11" FontWeight="Normal" TextWrapping="Wrap" MaxLines="2"
                                                                    Text="{Binding TrackingStatus, Mode=OneWay}" ToolTip="{Binding TrackingStatusToolTip}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <controls:DashboardTextColumn Header="Друк наклейки" Binding="{Binding LabelPrintStatus}" Width="170">
                                        <controls:DashboardTextColumn.ElementStyle>
                                            <Style TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}">
                                                <Setter Property="ToolTip" Value="{Binding LabelPrintStatusToolTip}" />
                                            </Style>
                                        </controls:DashboardTextColumn.ElementStyle>
                                    </controls:DashboardTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <GridSplitter x:Name="OrdersVerticalSplitter" Grid.Column="1" Width="5"
                                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="#D9DEE7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Перетягніть ліворуч або праворуч, щоб змінити ширину таблиць" />

                        <Grid x:Name="CheckboxReceiptsPane" Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel Margin="2,0,2,3">
                                <TextBlock Text="Чеки Checkbox" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Зв’язки чеків:" VerticalAlignment="Center" />
                                <ComboBox Width="175" ItemsSource="{Binding Marketplace.Filters}" SelectedItem="{Binding Marketplace.Filter}"
                                          ToolTip="Фільтр лише чеків — не приховує замовлення ліворуч." />
                                <TextBlock Text="Для ручної прив’язки виберіть рядок чека та замовлення." Foreground="#667085"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </WrapPanel>
                    <DataGrid x:Name="OrdersReceiptsGrid" Grid.Row="1" ItemsSource="{Binding OrdersReceiptsTab.View}" Style="{StaticResource ReceiptGridStyle}"
                              CurrentCellChanged="Dashboard_CurrentCellChanged"
                              SelectedItem="{Binding OrdersReceiptsTab.SelectedReceipt, Mode=OneWayToSource}"
                              Sorting="DataGrid_Sorting" MouseDoubleClick="ReceiptsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="66" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="OrdersReceiptsHeaderToggle" IsThreeState="True" VerticalAlignment="Center"
                                        AutomationProperties.Name="Вибрати або зняти всі чеки замовлень"
                                        ToolTip="Позначити видимі чеки; повторне натискання знімає всі галочки цієї таблиці" />
                                    <Button x:Name="OrdersReceiptsPrintCandidatesButton" Style="{StaticResource PrintCandidatesButtonStyle}"
                                            AutomationProperties.Name="Вибрати чеки замовлень — кандидати для друку"
                                            ToolTip="Позначити видимі ненадруковані чеки з пов’язаним нескасованим замовленням. Решту видимих галочок зняти; приховані зберегти." />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <controls:DashboardTextColumn Header="Дата й час" Binding="{Binding LocalDateTime, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}" Width="160" IsReadOnly="True" SortMemberPath="LocalDateTime" />
                            <controls:DashboardTextColumn Header="Сума" Binding="{Binding Total, StringFormat=N2}" Width="95" IsReadOnly="True"
                                                          ElementStyle="{StaticResource DashboardAmountTextStyle}" />
                            <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Перегляд" Padding="6,2" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <controls:DashboardTextColumn Header="Фіскальний номер" Binding="{Binding FiscalCode}" Width="170" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Номер чека" Binding="{Binding Serial}" Width="105" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Тип чека" Binding="{Binding Type}" Width="150" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Оплата" Binding="{Binding Payment}" Width="160" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Статус" Binding="{Binding Status}" Width="105" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Каса" Binding="{Binding CashRegister}" Width="150" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Друк" Binding="{Binding PrintStatusText}" Width="110" IsReadOnly="True" />
                            <controls:DashboardTextColumn Header="Маркетплейс" Binding="{Binding Marketplace}" Width="100" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="№ замовлення" Width="125" SortMemberPath="OrderNumber" ClipboardContentBinding="{Binding OrderNumber}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:DashboardTextBox Style="{StaticResource DashboardLinkTextStyle}" Text="{Binding OrderLinkButtonText, Mode=OneWay}"
                                                ToolTip="Виділіть текст мишкою; клік відкриває пов’язане замовлення або кандидатів"
                                                Command="{Binding DataContext.Marketplace.ShowOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <controls:DashboardTextColumn Header="Зв’язок" Binding="{Binding LinkStatus}" Width="230" IsReadOnly="True">
                                <controls:DashboardTextColumn.ElementStyle><Style TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}"><Setter Property="ToolTip" Value="{Binding LinkExplanation}" /></Style></controls:DashboardTextColumn.ElementStyle>
                            </controls:DashboardTextColumn>
                            <controls:DashboardTextColumn Header="Покупець" Binding="{Binding OrderBuyer}" Width="180" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                            <controls:DashboardTextColumn Header="Статус замовлення" Binding="{Binding OrderStatus}" Width="150" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                            <controls:DashboardTextColumn Header="ТТН" Binding="{Binding OrderTracking}" Width="155" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Усі накладні">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                        <TextBlock Text="Перевізник:" VerticalAlignment="Center" Margin="3" />
                        <ComboBox Width="185" ItemsSource="{Binding Waybills.Carriers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Waybills.SelectedCarrier}" />
                        <Button Content="Скасувати завантаження" Command="{Binding Waybills.CancelCommand}" />
                        <ProgressBar Width="110" Height="14" IsIndeterminate="True" Margin="10,0" VerticalAlignment="Center"
                                     Visibility="{Binding Waybills.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,6">
                        <TextBlock Text="{Binding Waybills.CountText}" Foreground="#48566A" />
                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Waybills.Status}" Foreground="#667085" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                    <DataGrid x:Name="AllWaybillsGrid" ItemsSource="{Binding Waybills.View}" Style="{StaticResource ReceiptGridStyle}"
                              SelectedItem="{Binding Waybills.SelectedRow, Mode=OneWayToSource}" CurrentCellChanged="Dashboard_CurrentCellChanged"
                              IsReadOnly="True" RowStyle="{StaticResource WaybillRowStyle}" Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="76" CanUserSort="False" ClipboardContentBinding="{Binding DisplayIndex}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <CheckBox x:Name="WaybillsHeaderToggle" IsThreeState="True" VerticalAlignment="Center"
                                            AutomationProperties.Name="Вибрати або зняти всі накладні"
                                            ToolTip="Позначити видимі доступні накладні; повторне натискання знімає всі галочки накладних" />
                                        <TextBlock Text="№" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Focusable="False" />
                                        <controls:DashboardTextBox Style="{StaticResource DashboardTextStyle}" Text="{Binding DisplayIndex, Mode=OneWay}"
                                                                  MinWidth="26" TextAlignment="Right" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ТТН" Width="170" SortMemberPath="TrackingNumber" ClipboardContentBinding="{Binding TrackingNumber}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <controls:DashboardTextBox Style="{StaticResource DashboardLinkTextStyle}" Text="{Binding TrackingNumber, Mode=OneWay}"
                                        Command="{Binding DataContext.Waybills.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="Виділіть текст мишкою; клік відкриває перегляд накладної" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <controls:DashboardTextColumn Header="Дата" Binding="{Binding CreatedLocal, StringFormat=dd.MM.yyyy HH:mm}" Width="140" SortMemberPath="CreatedLocal" />
                            <controls:DashboardTextColumn Header="Пов’язані замовлення" Binding="{Binding AssociatedOrders}" Width="210">
                                <controls:DashboardTextColumn.ElementStyle>
                                    <Style TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}">
                                        <Setter Property="ToolTip" Value="За точним номером ТТН серед завантажених замовлень" />
                                    </Style>
                                </controls:DashboardTextColumn.ElementStyle>
                            </controls:DashboardTextColumn>
                            <controls:DashboardTextColumn Header="Друк" Binding="{Binding PrintStatusText}" Width="175">
                                <controls:DashboardTextColumn.ElementStyle>
                                    <Style TargetType="controls:DashboardTextBox" BasedOn="{StaticResource DashboardTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding PrintStatusToolTip}" />
                                    </Style>
                                </controls:DashboardTextColumn.ElementStyle>
                            </controls:DashboardTextColumn>
                            <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="Перегляд" Padding="6,2"
                                        Command="{Binding DataContext.Waybills.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <controls:DashboardTextColumn Header="Перевізник" Binding="{Binding CarrierName}" Width="145" />
                            <controls:DashboardTextColumn Header="Акаунт" Binding="{Binding ConnectionName}" Width="170" />
                            <controls:DashboardTextColumn Header="Статус" Binding="{Binding Status}" Width="200" />
                            <controls:DashboardTextColumn Header="Отримувач" Binding="{Binding Recipient}" Width="200" />
                            <controls:DashboardTextColumn Header="Місто / відділення" Binding="{Binding City}" Width="180" />
                            <controls:DashboardTextColumn Header="Оголошена вартість" Binding="{Binding DeclaredValue, StringFormat=N2}" Width="145" />
                            <controls:DashboardTextColumn Header="Місць" Binding="{Binding Places}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
