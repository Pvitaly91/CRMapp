<Window x:Class="CheckboxBatchPrinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkbox Batch Printer" Height="760" Width="1320" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ReceiptRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RawType}" Value="SELL"><Setter Property="Background" Value="#F2FBF5" /></DataTrigger>
                <DataTrigger Binding="{Binding RawType}" Value="RETURN"><Setter Property="Background" Value="#FFF0F0" /></DataTrigger>
                <DataTrigger Binding="{Binding RawType}" Value="SERVICE_IN"><Setter Property="Background" Value="#EEF6FF" /></DataTrigger>
                <DataTrigger Binding="{Binding RawType}" Value="SERVICE_OUT"><Setter Property="Background" Value="#EEF6FF" /></DataTrigger>
                <DataTrigger Binding="{Binding PrintStatus}" Value="Done">
                    <Setter Property="Background" Value="#C7F2D4" />
                    <Setter Property="Foreground" Value="#075E3A" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="{Binding PrintError}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PrintStatus}" Value="Error"><Setter Property="ToolTip" Value="{Binding PrintError}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiptGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="#D9DEE7" />
            <Setter Property="RowStyle" Value="{StaticResource ReceiptRowStyle}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel>
                    <TextBlock Text="Дата від" VerticalAlignment="Center" Margin="3" />
                    <DatePicker Width="145" SelectedDate="{Binding DateFrom}" />
                    <Button Content="×" Command="{Binding ClearDateCommand}" CommandParameter="from"
                            ToolTip="Скинути дату від" MinWidth="28" Padding="5,2" />
                    <TextBlock Text="Дата до" VerticalAlignment="Center" Margin="8,3,3,3" />
                    <DatePicker Width="145" SelectedDate="{Binding DateTo}" />
                    <Button Content="×" Command="{Binding ClearDateCommand}" CommandParameter="to"
                            ToolTip="Скинути дату до" MinWidth="28" Padding="5,2" />
                    <Button Content="Сьогодні" Command="{Binding TodayCommand}" />
                    <Button Content="Оновити чеки" Command="{Binding RefreshCommand}" ToolTip="F5 — оновити лише чеки Checkbox" />
                </WrapPanel>
                <Button Grid.Column="1" Content="Налаштування" Command="{Binding SettingsCommand}" VerticalAlignment="Top" />
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="3" />
                    <TextBox x:Name="ReceiptSearchInput" Width="330" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Пошук у поточній вкладці. На «Усі чеки» — лише дані чека; на «Чеки та замовлення» — також дані замовлення та ТТН." />
                    <ComboBox Width="180" ItemsSource="{Binding ReceiptTypes}" SelectedItem="{Binding SelectedType}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.ColumnSpan="2">
                    <Button Content="Вибрати всі видимі" Command="{Binding SelectAllCommand}" ToolTip="Ctrl+A — усі видимі в активній вкладці" />
                    <Button Content="Зняти весь вибір" Command="{Binding ClearSelectionCommand}" ToolTip="Зняти видимі та приховані позначки активної вкладки" />
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    <Button Content="Перегляд" Command="{Binding PreviewCommand}" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="110" Height="14" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="10,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Повторити невдалі" Command="{Binding RetryFailedCommand}" />
                    <Button Content="Друк вибраних видимих" Command="{Binding PrintSelectedCommand}" FontWeight="Bold"
                            Background="#1769AA" Foreground="White" ToolTip="Ctrl+P — друк вибраних видимих в активній вкладці" Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="14,4,14,8" Foreground="#48566A" />

        <TabControl x:Name="ReceiptTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="10,8,10,2">
            <TabItem Header="Усі чеки">
                <DataGrid x:Name="AllReceiptsGrid" ItemsSource="{Binding AllReceiptsTab.View}" Style="{StaticResource ReceiptGridStyle}"
                          SelectedItem="{Binding AllReceiptsTab.SelectedReceipt, Mode=TwoWay}"
                          Sorting="DataGrid_Sorting" MouseDoubleClick="ReceiptsGrid_MouseDoubleClick" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="42" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Дата" Binding="{Binding LocalDate, StringFormat=dd.MM.yyyy}" Width="100" IsReadOnly="True" SortMemberPath="LocalDate" />
                        <DataGridTextColumn Header="Час" Binding="{Binding LocalTime}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Тип чека" Binding="{Binding Type}" Width="135" IsReadOnly="True" />
                        <DataGridTextColumn Header="Фіскальний номер" Binding="{Binding FiscalCode}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="Номер чека" Binding="{Binding Serial}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat=N2}" Width="95" IsReadOnly="True" />
                        <DataGridTextColumn Header="Оплата" Binding="{Binding Payment}" Width="155" IsReadOnly="True" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Каса" Binding="{Binding CashRegister}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="Друк" Binding="{Binding PrintStatusText}" Width="120" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="Перегляд" Padding="6,2" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Чеки та замовлення">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                        <Border Background="#EDF6FF" Padding="8" Margin="0,0,0,5"
                                Visibility="{Binding Marketplace.ShowSetupHint, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <TextBlock Text="Інтеграції не налаштовані.&#x0a;Усі чеки доступні на вкладці “Усі чеки”."
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,0,12,0" />
                                <Button Content="Налаштування маркетплейсів" Command="{Binding MarketplaceSettingsCommand}" />
                            </WrapPanel>
                        </Border>
                        <WrapPanel>
                            <Button Content="Оновити замовлення" Command="{Binding Marketplace.SyncCommand}" />
                            <Button Content="Розширити на 30 днів" Command="{Binding Marketplace.ExpandCommand}" />
                            <Button Content="Скасувати оновлення" Command="{Binding Marketplace.CancelCommand}" />
                            <Button Content="Налаштування маркетплейсів" Command="{Binding MarketplaceSettingsCommand}"
                                    Visibility="{Binding Marketplace.HasEnabledConnections, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox x:Name="ExtraOrderColumns" Content="Покупець, статус, ТТН у таблиці" VerticalAlignment="Center" Margin="12,0" />
                        </WrapPanel>
                        <CheckBox x:Name="AutomaticOrderLinks" Content="Автоматично шукати ймовірні зв’язки за товарами"
                                  IsChecked="{Binding Marketplace.AutoLinkEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="3,6,3,3"
                                  ToolTip="При відкритті цієї вкладки та після оновлення чеків тут: завантажити замовлення й порівняти товари, кількість, ціни, суму та час. Ймовірний зв’язок не є підтвердженням фіскального документа. Налаштування діє до закриття програми." />
                        <TextBlock Text="{Binding Marketplace.Status}" TextWrapping="Wrap" FontSize="11" Foreground="#48566A" Margin="3" MaxHeight="55" />
                        <TextBlock Text="{Binding Marketplace.FiscalSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#48566A" Margin="3" />
                        <TextBlock Text="{Binding Marketplace.ReceiptScopeText}" Foreground="#667085" FontSize="11" Margin="3" />
                    </StackPanel>

                    <Expander DockPanel.Dock="Bottom" Header="Пов’язане замовлення" IsExpanded="False" Margin="2,6,2,2">
                        <Grid MaxHeight="250">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel>
                                <Button Content="Зв’язати / змінити прив’язку" Command="{Binding Marketplace.LinkCommand}" />
                                <Button Content="Відв’язати" Command="{Binding Marketplace.UnlinkCommand}" />
                                <Button Content="Копіювати № замовлення" Command="{Binding Marketplace.CopyNumberCommand}" />
                                <Button Content="Копіювати ТТН" Command="{Binding Marketplace.CopyTrackingCommand}" />
                            </WrapPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Marketplace.DetailsText}" TextWrapping="Wrap" Margin="6" />
                                    <ItemsControl ItemsSource="{Binding Marketplace.OrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,2" TextWrapping="Wrap">
                                                    <Run Text="{Binding Sku}" /><Run Text=" — " /><Run Text="{Binding Name}" /><Run Text=" · " />
                                                    <Run Text="{Binding Quantity}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, StringFormat=N2}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Expander>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="*" MinHeight="110" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,3">
                                <TextBlock Text="Замовлення — усі завантажені" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Marketplace.OrderListSummary}" Foreground="#48566A" FontSize="11"
                                           Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,3">
                                <TextBlock Text="Пошук замовлень:" VerticalAlignment="Center" Margin="3,0,5,0" />
                                <TextBox x:Name="OrderSearchInput" Width="210"
                                         Text="{Binding Marketplace.OrderSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Пошук лише серед завантажених замовлень — не приховує чеки нижче." />
                                <ComboBox x:Name="OrderFilterInput" Width="150" ItemsSource="{Binding Marketplace.OrderFilters}"
                                          SelectedItem="{Binding Marketplace.OrderFilter}" ToolTip="Фільтр лише замовлень" />
                                <Button Content="Прив’язати вибрані" Command="{Binding Marketplace.LinkSelectedOrderCommand}"
                                        ToolTip="Виберіть замовлення зверху та чек знизу. Прив’язку буде збережено лише після підтвердження." />
                                <Button Content="Зіставити за товарами" Command="{Binding Marketplace.AutoMatchCommand}"
                                        ToolTip="Завантажити деталі чеків лише для читання. Сума + повний склад товарів; неточні збіги потребують перевірки." />
                            </WrapPanel>
                            <DataGrid x:Name="MarketplaceOrdersGrid" Grid.Row="2" ItemsSource="{Binding Marketplace.Orders}"
                                      SelectedItem="{Binding Marketplace.SelectedOrder, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" BorderBrush="#D9DEE7" AlternatingRowBackground="#F5F8FC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Маркетплейс" Binding="{Binding Marketplace}" Width="100" />
                                    <DataGridTextColumn Header="Магазин" Binding="{Binding StoreName}" Width="130" />
                                    <DataGridTextColumn Header="№ замовлення" Binding="{Binding Number}" Width="125" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="135" />
                                    <DataGridTextColumn Header="Сума / валюта" Binding="{Binding TotalDisplay}" Width="175">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding TotalDisplay}" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Зв’язок із чеками" Binding="{Binding LinkStatus}" Width="175" />
                                    <DataGridTextColumn Header="Пов’язані чеки" Binding="{Binding LinkedReceiptsDisplay}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding LinkedReceiptsDisplay}" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Покупець" Binding="{Binding BuyerDisplay}" Width="180"
                                        Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                                    <DataGridTextColumn Header="Статус замовлення" Binding="{Binding Status}" Width="150"
                                        Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                                    <DataGridTextColumn Header="ТТН" Binding="{Binding TrackingDisplay}" Width="155"
                                        Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="#D9DEE7" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Змінити висоту таблиць замовлень і чеків" />

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel Margin="2,0,2,3">
                                <TextBlock Text="Чеки Checkbox" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Зв’язки чеків:" VerticalAlignment="Center" />
                                <ComboBox Width="175" ItemsSource="{Binding Marketplace.Filters}" SelectedItem="{Binding Marketplace.Filter}"
                                          ToolTip="Фільтр лише чеків — не приховує замовлення зверху." />
                                <TextBlock Text="Для ручної прив’язки виберіть рядок чека та замовлення." Foreground="#667085"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </WrapPanel>
                    <DataGrid x:Name="OrdersReceiptsGrid" Grid.Row="1" ItemsSource="{Binding OrdersReceiptsTab.View}" Style="{StaticResource ReceiptGridStyle}"
                              SelectedItem="{Binding OrdersReceiptsTab.SelectedReceipt, Mode=TwoWay}"
                              Sorting="DataGrid_Sorting" MouseDoubleClick="ReceiptsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="42" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LocalDate, StringFormat=dd.MM.yyyy}" Width="100" IsReadOnly="True" SortMemberPath="LocalDate" />
                            <DataGridTextColumn Header="Час" Binding="{Binding LocalTime}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Тип чека" Binding="{Binding Type}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Фіскальний номер" Binding="{Binding FiscalCode}" Width="170" IsReadOnly="True" />
                            <DataGridTextColumn Header="Номер чека" Binding="{Binding Serial}" Width="105" IsReadOnly="True" />
                            <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat=N2}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Оплата" Binding="{Binding Payment}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="105" IsReadOnly="True" />
                            <DataGridTextColumn Header="Каса" Binding="{Binding CashRegister}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Друк" Binding="{Binding PrintStatusText}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Маркетплейс" Binding="{Binding Marketplace}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="№ замовлення" Binding="{Binding OrderNumber}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Зв’язок" Binding="{Binding LinkStatus}" Width="165" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding LinkExplanation}" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Покупець" Binding="{Binding OrderBuyer}" Width="180" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="Статус замовлення" Binding="{Binding OrderStatus}" Width="150" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="ТТН" Binding="{Binding OrderTracking}" Width="155" IsReadOnly="True"
                                Visibility="{Binding IsChecked, Source={x:Reference ExtraOrderColumns}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Перегляд" Padding="6,2" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
