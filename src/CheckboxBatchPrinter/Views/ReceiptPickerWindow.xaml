<Window x:Class="CheckboxBatchPrinter.Views.ReceiptPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прив’язати чек до замовлення" Width="1120" Height="680" MinWidth="620" MinHeight="430"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" Background="#F5F7FA">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5DCE5" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding OrderHeading}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding OrderDate}" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OrderAmount}" FontWeight="Bold" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel IsEnabled="{Binding CanEditFilters}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Дата від" Margin="3,0,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearDateFromCommand}"
                                Padding="8,2" ToolTip="Очистити дату від" />
                        <DatePicker SelectedDate="{Binding DateFrom}" Width="145" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Дата до" Margin="3,0,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearDateToCommand}"
                                Padding="8,2" ToolTip="Очистити дату до" />
                        <DatePicker SelectedDate="{Binding DateTo}" Width="145" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Пошук за ID, номером або сумою чека" Margin="3,0,0,2" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="320" MinHeight="30"
                             ToolTip="UUID, фіскальний номер, № чека або точна сума; наприклад: 390,00" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding FilterMessage}" Foreground="#A63B22" TextWrapping="Wrap" Margin="3,5,0,0" />
            <TextBlock Text="{Binding ResultCount}" Foreground="#536174" Margin="3,5,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding PreviewError}" Foreground="#A63B22" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="Виберіть чек зі списку та натисніть «Прив’язати чек»." Foreground="#536174" TextWrapping="Wrap" />
            <TextBlock Text="Показано завантажені чеки без прив’язки. Для іншого періоду оновіть чеки в головному вікні."
                       Foreground="#536174" TextWrapping="Wrap" Margin="0,3,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                <Button Content="Скасувати" IsCancel="True" IsEnabled="{Binding CanEditFilters}" />
                <Button Content="Прив’язати чек" Command="{Binding LinkCommand}" Background="#176BAA" Foreground="White" />
            </StackPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" IsEnabled="{Binding CanEditFilters}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  BorderBrush="#D5DCE5" HorizontalScrollBarVisibility="Auto" RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата й час" Binding="{Binding LocalDateTime, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}"
                                    SortMemberPath="LocalDateTime" Width="155" />
                <DataGridTextColumn Header="Сума" Binding="{Binding TotalDisplay}" SortMemberPath="Total" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="100" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Перегляд" Padding="10,3"
                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="№ чека" Binding="{Binding Serial}" SortMemberPath="Model.Serial" Width="85" />
                <DataGridTextColumn Header="Фіскальний номер" Binding="{Binding FiscalCode}" Width="155" />
                <DataGridTextColumn Header="Тип чека" Binding="{Binding Type}" Width="100" />
                <DataGridTextColumn Header="ID чека" Binding="{Binding Id}" Width="300" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
