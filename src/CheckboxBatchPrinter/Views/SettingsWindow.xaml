<Window x:Class="CheckboxBatchPrinter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Height="700" Width="760" MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Скасувати" IsCancel="True">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Style.Triggers></Style></Button.Style>
            </Button>
            <Button x:Name="SaveSettingsButton" Content="Зберегти" Click="Save_Click" IsDefault="True" Background="#1769AA" Foreground="White">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    <DataTrigger Binding="{Binding Marketplace.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Style.Triggers></Style></Button.Style>
            </Button>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
            <TabControl.Style><Style TargetType="TabControl"><Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers></Style></TabControl.Style>
            <TabItem Header="Checkbox">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Read-only доступ до вже існуючих чеків. Програма не створює та не фіскалізує чеки."
                               TextWrapping="Wrap" Padding="10" Background="#EDF6FF" Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1" Text="Логін касира" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Пароль касира" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" PasswordChanged="PasswordInput_PasswordChanged" Margin="3" Padding="6,4" />
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock x:Name="CheckboxCredentialIndicator" Text="{Binding CredentialStatus}" Tag="{Binding CredentialStatusKind}" Style="{StaticResource CredentialIndicatorStyle}" />
                        <TextBlock Text="Потрібні дані касира Checkbox. Порожній пароль залишає збережений." Foreground="#667085" FontSize="11" TextWrapping="Wrap" Margin="5,0,0,8" />
                    </StackPanel>
                    <Button Grid.Row="4" Grid.Column="1" Content="Перевірити підключення" HorizontalAlignment="Left" Click="TestApi_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="Друк">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Принтер чеків" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" />
                    <TextBlock Grid.Row="1" Text="Ширина паперу" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PaperWidths}" SelectedValuePath="Value" SelectedValue="{Binding PaperWidth}" />
                    <TextBlock Grid.Row="2" Text="Custom, мм" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomPaperWidthMm}" IsEnabled="{Binding IsCustomPaperWidth}" />
                    <TextBlock Grid.Row="3" Text="Ширина області друку, мм" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PrintableWidthMm}" />
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="3,12" TextWrapping="Wrap" Foreground="#667085"
                               Text="Чеки передаються групами по 3 у вибраному порядку. Остання група може містити 1–2 чеки. Вся сторінка друкується як зображення, включно з номером замовлення та ТТН." />
                    <Button Grid.Row="5" Grid.Column="1" Content="Надрукувати тест" HorizontalAlignment="Left" Click="TestPrint_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="Фоновий режим">
                <StackPanel Margin="18">
                    <CheckBox Content="Автоматично оновлювати дані" IsChecked="{Binding AutoRefreshEnabled}" />
                    <CheckBox Content="Сповіщати Windows про нові замовлення" IsChecked="{Binding NotifyNewOrders}" />
                    <WrapPanel Margin="4,8"><TextBlock Text="Інтервал, хвилин:" VerticalAlignment="Center" />
                        <ComboBox Width="70" Margin="8,0" ItemsSource="{Binding BackgroundIntervals}" SelectedItem="{Binding BackgroundIntervalMinutes}" /></WrapPanel>
                    <WrapPanel Margin="4,4"><TextBlock Text="Робочий період, днів:" VerticalAlignment="Center" />
                        <TextBox Width="60" Margin="8,0" Text="{Binding BackgroundWorkingDays}" /></WrapPanel>
                    <CheckBox Content="Залишати програму в треї після закриття вікна" IsChecked="{Binding KeepInTray}" />
                    <CheckBox Content="Запускати разом із Windows" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Content="Запускати згорнуто в трей" IsChecked="{Binding StartMinimizedToTray}" />
                    <TextBlock Text="{Binding AutostartWarning}" Foreground="#A13B00" TextWrapping="Wrap" Margin="4,10" />
                    <TextBlock Text="Фон лише читає дані. Друк, фіскальні операції та зміни замовлень не запускаються автоматично."
                               TextWrapping="Wrap" Foreground="#667085" Margin="4,10" />
                </StackPanel>
            </TabItem>
            <TabItem x:Name="MarketplaceTab" Header="Маркетплейси">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" DataContext="{Binding Marketplace}">
                        <TextBlock Text="Лише читання замовлень. Prom: токен із правом читання замовлень. Rozetka: API-токен із кабінету «Налаштування → Безпека API». Виберіть сервіс, введіть або замініть токен і натисніть «Зберегти». Токен оновлюється в тому самому підключенні."
                                   TextWrapping="Wrap" Background="#EDF6FF" Padding="10" />
                        <StackPanel IsEnabled="{Binding CanEdit}">
                        <WrapPanel>
                            <Button x:Name="PromConnectionButton" Content="{Binding PromConnectionButtonText}" Command="{Binding AddPromCommand}"
                                    ToolTip="Відкрити налаштування Prom. Якщо підключення вже є, токен змінюється в ньому зі збереженням історії." />
                            <Button x:Name="RozetkaConnectionButton" Content="{Binding RozetkaConnectionButtonText}" Command="{Binding AddRozetkaCommand}"
                                    ToolTip="Відкрити налаштування Rozetka. Якщо підключення вже є, токен змінюється в ньому зі збереженням історії." />
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
                        <TextBlock x:Name="MarketplaceCredentialIndicator" Text="{Binding CredentialStatus}" Tag="{Binding CredentialStatusKind}" Style="{StaticResource CredentialIndicatorStyle}" />
                        <CheckBox Content="Увімкнути підключення" IsChecked="{Binding Selected.Enabled}" Margin="6,8" />
                        <TextBlock Text="Назва підключення / магазину" Margin="6,3" />
                        <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Visibility="{Binding IsProm, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="API-токен Prom" Margin="6,3" />
                            <PasswordBox x:Name="PromTokenInput" PasswordChanged="PromTokenInput_PasswordChanged" Margin="3" Padding="6,4" />
                            <Button x:Name="PromCabinetLoginButton" Content="Увійти в кабінет Prom для накладних"
                                    Command="{Binding ConnectPromCabinetCommand}" HorizontalAlignment="Left" Margin="3,8,3,3" />
                            <TextBlock x:Name="PromCabinetStatusText" Text="{Binding PromCabinetStatus}" TextWrapping="Wrap" Margin="6,3" />
                            <TextBlock Text="Для доставки в Rozetka у замовленнях Prom і Bigl увійдіть у кабінет цього магазину. Вхід зберігається на цьому комп’ютері; доступ до накладної перевіряється під час друку. Окремий ключ Rozetka Delivery не потрібний."
                                       TextWrapping="Wrap" Foreground="#667085" Margin="6,3,6,8" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsRozetka, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="API-токен Rozetka" Margin="6,3" />
                            <PasswordBox x:Name="RozetkaTokenInput" PasswordChanged="RozetkaTokenInput_PasswordChanged" Margin="3" Padding="6,4" />
                            <TextBlock Text="Створіть токен у кабінеті продавця Rozetka: «Налаштування → Безпека API». Вставте його сюди для цього самого магазину й натисніть «Зберегти». Збережені замовлення та прив’язки залишаться в цьому підключенні."
                                       TextWrapping="Wrap" Foreground="#667085" Margin="6,5" />
                        </StackPanel>
                        <TextBlock Text="Збережені токени не показуються: порожнє поле залишає попереднє значення. Введені чернетки зберігаються при перемиканні магазинів; для запису на диск натисніть «Зберегти»."
                                   TextWrapping="Wrap" Foreground="#667085" Margin="6,5" />
                        <Button Content="Перевірити підключення" Command="{Binding TestCommand}" HorizontalAlignment="Left" />
                        <WrapPanel Margin="0,6">
                            <TextBlock Text="Додатково до «Дата від», днів:" VerticalAlignment="Center" />
                            <TextBox Text="{Binding HistoryDays}" Width="70"
                                     ToolTip="0 — завантажувати тільки вибрані дати. Більше значення додає попередні дні та збільшує час оновлення. Уже завантажена історія залишається в кеші." />
                            <TextBlock Text="Строк кешу, днів:" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBox Text="{Binding CacheDays}" Width="70" />
                        </WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Background="#F2F4F7" Padding="10" Margin="3,6" />
                        <ProgressBar Height="10" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Друк наклейок">
                <StackPanel Margin="16">
                    <TextBlock Text="Окремий принтер, формат носія та підключення доставки. Не змінює налаштування друку чеків." TextWrapping="Wrap" />
                    <Button Content="Налаштувати друк наклейок і доставку" Command="{Binding Labels.SettingsCommand}" HorizontalAlignment="Left" Margin="0,12" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Діагностика">
                <StackPanel Margin="16">
                    <TextBlock Text="Версія програми" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion}" Margin="0,2,0,12" />
                    <TextBlock Text="Папка даних" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <TextBlock Text="Версія API" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ApiVersion}" Margin="0,2,0,12" />
                    <TextBlock Text="Папка логів" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <WrapPanel>
                        <Button Content="Перевірити Checkbox API" Click="TestApi_Click" />
                        <Button Content="Перевірити принтер / тест" Click="TestPrint_Click" />
                        <Button Content="Очистити кеш" Click="ClearCache_Click" />
                        <Button Content="Відкрити папку логів" Click="OpenLogs_Click" />
                    </WrapPanel>
                    <Border Background="#F2F4F7" Padding="10" Margin="3,14">
                        <TextBlock Text="{Binding DiagnosticStatus}" TextWrapping="Wrap" />
                    </Border>
                    <ProgressBar Height="12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
